{
  "name": "kotlinc",
  "id": "kotlinc",
  "version": "1.2.0",
  "description": "Kotlin compiler and ktlint (requires Java; Debian and Ubuntu)",
  "containerEnv": {
    "PATH": "/opt/kotlinc/bin:${PATH}"
  },
  "installsAfter": [
    "ghcr.io/devcontainers/features/common-utils:2",
    "ghcr.io/devcontainers/features/java:1"
  ]
}
